  {"id": "s1", "seg": "钩子", "scene": "hook", "text": "一台帐篷空调，[15 天]内出货。", "say": "一台帐篷空调，十五天内出货。", "src": "官网 Company：ships on time within 15 days"},
  {"id": "s2", "seg": "冲突", "scene": "fear", "text": "做露营空调的品牌和跨境卖家，就怕三件事："},
  {"id": "s3", "seg": "冲突", "scene": "fear", "text": "[旺季交不了货]，[起订量太高]，[样品和大货不一样]。"},
  {"id": "s4", "seg": "证据", "scene": "who", "text": "我们是佛山顺德的瀚泱，SpaceCool 系列自己设计、自己生产。", "src": "官网首段：designs and manufactures SpaceCool … in Shunde, Foshan"},
  {"id": "s5", "seg": "证据", "scene": "factory", "text": "工厂 [5 万平方米]，每天 [2000 多台]，压缩机[自己研发]。", "say": "工厂五万平方米，每天两千多台，压缩机自己研发。", "src": "官网 Company：50,000 m²、2,000+ units/day、in-house developed compressor"},
  {"id": "s6", "seg": "证据", "scene": "models", "text": "官网主推 4 款，[3000 到 6000BTU]，大的够 [8 到 10 平方米]的帐篷。", "say": "官网主推四款，三千到六千 BTU，大的够八到十平方米的帐篷。", "src": "官网 Products 4 款；Specifications：3000 / 5000 / 6000BTU，8–10 m²"},
  {"id": "s7", "seg": "证据", "scene": "c18", "text": "C18 [不用接排水管]，接水盘满了[自动停机]。", "say": "C 十八不用接排水管，接水盘满了自动停机。", "src": "官网 Specifications：C18 drainage-free; 1300ml tray, full-tank alarm and auto stop"},
  {"id": "s8", "seg": "转折", "scene": "moq", "text": "不定制，[没有起订量]；定制包装，[100 台起]。", "say": "不定制，没有起订量；定制包装，一百台起。", "src": "官网 Company：MOQ 100 units with custom packaging; no minimum without customization"},
  {"id": "s9", "seg": "转折", "scene": "lead", "text": "100 台以内的常规单，[大约 3 天]发货。", "say": "一百台以内的常规单，大约三天发货。", "src": "官网 Company：about 3 days under 100 units"},
  {"id": "s10", "seg": "转折", "scene": "custom", "text": "Logo、说明书、外箱[免费改]；整机[保修一年]。", "src": "官网 Company：Logo, manual and carton customization is free; Warranty 1 year"},
  {"id": "s11", "seg": "转折", "scene": "visit", "text": "担心样品和大货不一样，可以[预约]来顺德[看厂]。", "src": "官网 Company：Factory visits by appointment"},
  {"id": "s12", "seg": "行动", "scene": "cta", "text": "参数和报价，上瀚泱官网，[hafyoung-cooling.com]。", "say": "参数和报价，上瀚泱官网。", "src": "官网"}
